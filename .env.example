# Подключение к PostgreSQL. Скопируйте файл: cp .env.example .env
# Этот же файл читает docker-compose: он создаёт БД с этими данными,
# а backend в контейнере подключается к ней (хост там подменяется на `db`).
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# Для запуска backend без Docker (БД на вашем компьютере или в `docker compose up db`).
# Порт также используется как внешний порт контейнера db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Необязательно: готовая строка подключения вместо частей выше (например, для облачной БД).
# Если задана, POSTGRES_* игнорируются. Спецсимволы в пароле здесь нужно URL-кодировать.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Демо-режим
ENABLE_DEV_ENDPOINTS = 1 # демо-ручка «разобрать места»; в проде — 0
VITE_DEV_TOOLS = 1 # кнопки демо на шаге проверки заказа; в проде — 0

REDIS_URL = redis://redis:6379/0
RUN_DB_TESTS = 1
HOLD_TTL_SECONDS = 600 # сколько секунд держать бронь